# BridgeWatch live service. Build and run from prototype/:
#   docker build -f Dockerfile.bridgewatch -t bridgewatch .
#   docker run -p 8001:8001 -v bridgewatch-data:/data \
#     -e BRIDGEWATCH_WEBHOOK_URL=... -e BRIDGEWATCH_API_TOKEN=... bridgewatch
# Keep /data on a volume: it holds the SQLite database (transfers, alerts, cursor).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PORT=8001 BRIDGEWATCH_MODE=live BRIDGEWATCH_DB=/data/bridgewatch.db
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY bridgewatch/ bridgewatch/
COPY web/bridgewatch.html web/bridgewatch.html

RUN useradd --create-home --uid 10001 app && mkdir /data && chown app /data
USER app
VOLUME /data

EXPOSE 8001
HEALTHCHECK --interval=60s --timeout=5s --start-period=180s \
  CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/api/health' % os.environ['PORT'], timeout=4)"
# One worker: the live monitor is a single writer to the database.
CMD exec python -m uvicorn bridgewatch.app:app --host 0.0.0.0 --port "$PORT" --workers 1 --no-server-header
